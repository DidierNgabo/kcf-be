# --- Server ---
PORT=3000

# --- Database ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
DATABASE_NAME=kcf_db
# DATABASE_URL=   # optional full connection string; enables SSL automatically when set

# --- Redis (BullMQ mail queue + template cache) ---
REDIS_URL=redis://localhost:6379

# --- Mailtrap ---
MAILTRAP_TOKEN=
MAIL_FROM_NAME=Kwizera Charity Foundation
MAIL_FROM_EMAIL=hello@kwizeracharityfoundation.org
NOTIFICATION_EMAIL=

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- kcf-mis frontend origin (used to build password-reset links in emails) ---
MIS_FRONTEND_URL=http://localhost:3000

# --- One-time admin bootstrap (unset/rotate after the first successful boot) ---
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Admin

# --- Cloudflare R2 (private child media) ---
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_SIGNED_URL_TTL_SECONDS=300
R2_UPLOAD_URL_TTL_SECONDS=600
# Public base URL for the bucket (only prefixes deliberately made public,
# e.g. email-assets/, should ever be built into a URL with this).
STORAGE_PUBLIC_BASE_URL=
# Local development only. Production must use migrations with this disabled.
TYPEORM_SYNCHRONIZE=false
