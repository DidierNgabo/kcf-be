<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>New Sponsorship Inquiry</title>
  <style>
    body { margin: 0; padding: 0; background-color: #f4f4f4; font-family: Arial, sans-serif; }
    .wrapper { max-width: 600px; margin: 40px auto; background: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
    .header { background-color: #1a6b3c; padding: 28px 40px; }
    .header h1 { margin: 0; color: #ffffff; font-size: 20px; }
    .header p { margin: 4px 0 0; color: #c8e6d4; font-size: 13px; }
    .body { padding: 32px 40px; color: #333333; font-size: 15px; line-height: 1.6; }
    .field { margin-bottom: 18px; }
    .field label { display: block; font-size: 11px; font-weight: bold; text-transform: uppercase; letter-spacing: 0.6px; color: #888888; margin-bottom: 4px; }
    .field span { display: block; font-size: 15px; color: #111111; }
    .message-box { background: #f9f9f9; border: 1px solid #ececec; border-radius: 4px; padding: 14px 16px; font-size: 14px; color: #444444; line-height: 1.7; white-space: pre-wrap; }
    .footer { background-color: #f9f9f9; border-top: 1px solid #ececec; padding: 16px 40px; text-align: center; font-size: 12px; color: #aaaaaa; }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="header">
      <h1>New Sponsorship Inquiry</h1>
      <p>Submitted on {{date}}</p>
    </div>
    <div class="body">
      <div class="field">
        <label>Full Name</label>
        <span>{{name}}</span>
      </div>
      <div class="field">
        <label>Email</label>
        <span>{{email}}</span>
      </div>
      <div class="field">
        <label>Phone</label>
        <span>{{phone}}</span>
      </div>
      <div class="field">
        <label>Message</label>
        <div class="message-box">{{message}}</div>
      </div>
    </div>
    <div class="footer">
      KCF Internal Notification &bull; {{year}}
    </div>
  </div>
</body>
</html>
