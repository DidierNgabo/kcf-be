<!-- Hero -->
<div class="hero">
  {{#if childPhotoUrl}}
  <img src="{{childPhotoUrl}}" alt="{{childName}}" width="600" />
  {{else}}
  <img src="cid:match-child" alt="{{childName}}" width="600" />
  {{/if}}
</div>

<div class="section">
  <h1 class="title">You've Been Matched with {{childName}}!</h1>

  <div class="letter">
    <p>Dear <strong>{{sponsorName}}</strong>,</p>
    <p>We are thrilled to introduce you to someone very special. Meet <strong>{{childName}}</strong>, age {{childAge}}, your new little bestie in Kigali, Rwanda.</p>
  </div>

  <!-- About the child -->
  <div class="story-card">
    <h2>Getting to Know {{childName}}</h2>
    <p><strong>{{childName}}</strong> is a bright and curious {{childAge}}-year-old who dreams of becoming {{childDream}}. Their favourite subject in school is {{childSubject}}, and they light up whenever they get to learn something new.</p>
    <p>In their free time, {{childName}} loves {{childHobby}}, and their teachers describe them as {{childPersonality}}. They live with {{childFamily}} in {{childLocation}}, Kigali. What makes {{childName}} truly special is {{childUniqueQuality}}.</p>
  </div>

  <!-- Quote -->
  <div class="quote">
    <blockquote>"Hi, I'm {{childName}}. Thank you for sponsoring me. It means the world to me, {{sponsorName}}!"</blockquote>
  </div>

  <!-- Steps -->
  <h2 class="section-title">What Happens Next</h2>
  <div class="steps">
    <div class="step">
      <div class="step-num">1</div>
      <div class="step-body">
        <h3>Monthly Updates</h3>
        <p>You'll receive monthly progress updates on {{childName}}'s education and well-being.</p>
      </div>
    </div>
    <div class="step">
      <div class="step-num">2</div>
      <div class="step-body">
        <h3>Letters &amp; Photos</h3>
        <p>Send and receive letters, photos, and video messages to build your relationship.</p>
      </div>
    </div>
    <div class="step">
      <div class="step-num">3</div>
      <div class="step-body">
        <h3>Quarterly Reports</h3>
        <p>You'll get quarterly impact reports showing how your sponsorship is transforming their life.</p>
      </div>
    </div>
  </div>

  <!-- CTA -->
  <div class="cta-wrap">
    <a href="https://kwizeracharityfoundation.org" class="cta">View {{childName}}'s Welcome Page</a>
  </div>

  <!-- Signoff -->
  <p class="signoff">
    With deep gratitude and joy,<br>
    <span class="team">The Kwizera Team</span><br>
    and your new little bestie, {{childName}}
  </p>
</div>
