<div class="section">
  <h1 class="title">Your Sponsor Portal Account is Ready</h1>

  <div class="letter">
    <p>Hi {{name}},</p>
    <p>An account has been created for you so you can log in and view your sponsorship and the child you support.</p>
  </div>

  <div class="story-card">
    <h2>Your Login Details</h2>
    <p>Email: {{email}}</p>
    <p>Temporary password: {{temporaryPassword}}</p>
  </div>

  <div class="letter">
    <p>Please keep these credentials safe. We recommend changing your password after your first login.</p>
  </div>

  <div class="cta-wrap">
    <a href="{{loginUrl}}" class="cta">Log in to Your Account</a>
  </div>

  <p class="signoff">
    Thank you for your generosity,<br>
    <span class="team">The Kwizera Team</span>
  </p>
</div>
