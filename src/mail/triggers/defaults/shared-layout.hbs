<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{app.name}}</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: Arial, Helvetica, sans-serif;
    background: #E9ECF2;
    color: #364153;
    line-height: 1.5;
  }

  .page {
    max-width: 600px;
    margin: 0 auto;
    background: #FFFFFF;
  }

  /* ---------- Header ---------- */
  .header {
    text-align: center;
    padding: 36px 32px 0;
  }
  .logo {
    width: 140px;
    height: auto;
    margin: 0 auto 22px;
    display: block;
  }
  .tagline {
    font-size: 16px;
    line-height: 22px;
    color: #364153;
    max-width: 360px;
    margin: 0 auto;
  }

  /* ---------- Hero image ---------- */
  .hero {
    margin: 26px 0 0;
  }
  .hero img {
    width: 100%;
    display: block;
    height: auto;
  }

  /* ---------- Body ---------- */
  .section { padding: 0 32px; }

  h1.title {
    font-size: 22px;
    line-height: 27px;
    font-weight: 700;
    text-align: center;
    margin-top: 40px;
  }

  .letter {
    font-size: 16px;
    line-height: 26px;
    margin-top: 30px;
  }
  .letter p { margin-bottom: 18px; }
  .letter p:last-child { margin-bottom: 0; }

  /* ---------- Story / info card ---------- */
  .story-card {
    background: #3859A6;
    border-radius: 10px;
    color: #FFFFFF;
    padding: 30px 26px;
    margin: 36px 0 0;
  }
  .story-card h2 {
    font-size: 17px;
    line-height: 24px;
    font-weight: 700;
    margin-bottom: 14px;
  }
  .story-card p {
    font-size: 15px;
    line-height: 25px;
    margin-bottom: 14px;
  }
  .story-card p:last-child { margin-bottom: 0; }

  /* ---------- Steps ---------- */
  h2.section-title {
    font-size: 20px;
    line-height: 25px;
    font-weight: 700;
    text-align: center;
    margin-top: 42px;
  }

  .steps { margin-top: 30px; }
  .step {
    margin-bottom: 24px;
  }
  .step:last-child { margin-bottom: 0; }
  .step-num,
  .avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #3859A6;
    color: #FFFFFF;
    font-weight: 700;
    font-size: 15px;
    text-align: center;
    line-height: 40px;
  }
  .step-body { padding-top: 2px; }
  .step-body h3 {
    font-size: 15px;
    line-height: 19px;
    font-weight: 700;
    margin-bottom: 6px;
  }
  .step-body p {
    font-size: 14px;
    line-height: 22px;
  }

  /* ---------- Quote ---------- */
  .quote {
    border-left: 4px solid #3859A6;
    padding-left: 22px;
    margin-top: 40px;
  }
  .quote blockquote {
    font-style: italic;
    font-size: 15px;
    line-height: 24px;
  }
  .quote-author {
    margin-top: 22px;
  }
  .quote-author .name {
    font-style: italic;
    font-weight: 700;
    font-size: 15px;
    line-height: 19px;
  }
  .quote-author .role {
    font-style: italic;
    font-size: 14px;
    line-height: 22px;
  }

  /* ---------- CTA ---------- */
  .cta-wrap { text-align: center; margin-top: 40px; }
  .cta {
    display: inline-block;
    background: #3859A6;
    color: #FFFFFF;
    text-decoration: none;
    font-weight: 700;
    font-size: 15px;
    line-height: 19px;
    padding: 18px 34px;
    border-radius: 50px;
  }

  .fallback-link {
    word-break: break-all;
    font-size: 13px;
    color: #6a7282;
    margin-top: 14px;
  }

  .signoff {
    text-align: center;
    font-size: 16px;
    line-height: 28px;
    margin-top: 30px;
    padding-bottom: 44px;
  }
  .signoff .team { font-weight: 700; }

  /* ---------- Footer ---------- */
  .footer {
    background: #3859A6;
    color: #FFFFFF;
    text-align: center;
    padding: 36px 32px 50px;
  }
  .footer h4 {
    font-size: 16px;
    line-height: 19px;
    font-weight: 700;
    margin-bottom: 20px;
  }
  .socials {
    text-align: center;
    margin-bottom: 26px;
  }
  .social {
    display: inline-block;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #FFFFFF;
    text-align: center;
    line-height: 44px;
    margin: 0 9px;
  }
  .social img { vertical-align: middle; }
  .footer p {
    font-size: 14px;
    line-height: 28px;
  }
  .footer a {
    color: #FFFFFF;
    text-decoration: underline;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 640px) {
    .section { padding: 0 20px; }
    .header { padding: 28px 20px 0; }
    h1.title { font-size: 20px; margin-top: 32px; }
    .letter { font-size: 15px; }
    .story-card { padding: 24px 20px; }
    h2.section-title { margin-top: 32px; }
    .cta { padding: 16px 28px; font-size: 14px; }
  }
</style>
</head>
<body>
  <div class="page">

    <!-- Header -->
    <header class="header">
      <img src="cid:kcf-logo" class="logo" alt="{{app.name}}">
      <p class="tagline">We see a Rwanda where every child lives up to their full potential.</p>
    </header>

    {{{body}}}

    <!-- Footer -->
    <footer class="footer">
      <h4>Stay Connected</h4>
      <div class="socials">
        <a href="https://kwizeracharityfoundation.org" class="social" aria-label="Website">
          <img src="cid:icon-website" width="22" height="22" alt="Website">
        </a>
        <a href="https://www.instagram.com/kwizeracharityfoundation" class="social" aria-label="Instagram">
          <img src="cid:icon-instagram" width="22" height="22" alt="Instagram">
        </a>
        <a href="https://www.facebook.com/KwizeraCharityFoundation" class="social" aria-label="Facebook">
          <img src="cid:icon-facebook" width="22" height="22" alt="Facebook">
        </a>
        <a href="mailto:info@kwizeracharityfoundation.org" class="social" aria-label="Email">
          <img src="cid:icon-email" width="22" height="22" alt="Email">
        </a>
      </div>
      <p>Kwizera Charity Foundation</p>
      <p>Kigali, Rwanda</p>
      <p><a href="mailto:info@kwizeracharityfoundation.org">info@kwizeracharityfoundation.org</a></p>
    </footer>

  </div>
</body>
</html>
