<div class="section">
  <h1 class="title">Your KCF Account is Ready</h1>

  <div class="letter">
    <p>Hi {{name}},</p>
    <p>An account has been created for you on the KCF Management System.</p>
  </div>

  <div class="story-card">
    <h2>Your Login Details</h2>
    <p>Email: {{email}}</p>
    <p>Temporary password: {{temporaryPassword}}</p>
  </div>

  <div class="letter">
    <p>Please keep these credentials safe. We recommend changing your password after your first login.</p>
  </div>

  <p class="signoff">
    Welcome to the team,<br>
    <span class="team">The Kwizera Team</span>
  </p>
</div>
